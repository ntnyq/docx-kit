{
  "name": "docx-kit",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "description": "CSS-like DOCX API Kit — a type-safe, plugin-extensible DOCX generation library built on dolanmiu/docx.",
  "license": "MIT",
  "scripts": {
    "apps:build": "pnpm --filter @docxkit/playground --filter @docxkit/theme-studio run build",
    "apps:bundle": "tsx scripts/check-app-bundle.ts",
    "apps:generated": "git diff --exit-code -- apps/playground/src/utils/monacoTypes.generated.ts",
    "apps:typecheck": "pnpm --filter @docxkit/app-shared --filter @docxkit/playground --filter @docxkit/theme-studio run typecheck",
    "apps:verify": "run-s apps:typecheck apps:build apps:bundle apps:generated",
    "bench:browser": "tsx scripts/performance/run-browser.ts",
    "bench:browser:update": "tsx scripts/performance/run-browser.ts --update-baseline",
    "bench:node": "tsx scripts/performance/run-node.ts",
    "bench:node:update": "tsx scripts/performance/run-node.ts --update-baseline",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./packages-plugins/**\" --filter \"./packages-presets/**\" --filter \"./packages-themes/**\" run build",
    "dev": "pnpm -r --filter \"./packages/**\" --filter \"./packages-plugins/**\" --filter \"./packages-presets/**\" --filter \"./packages-themes/**\" --parallel run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:bundle": "tsx scripts/check-doc-bundle.ts",
    "docs:dev": "pnpm -C docs run dev",
    "docs:examples": "tsx scripts/check-doc-examples.ts",
    "docs:verify": "run-s docs:examples docs:build docs:bundle",
    "lint": "eslint",
    "playground:dev": "pnpm --filter @docxkit/playground run dev",
    "prepare": "husky",
    "release": "run-s release:verify release:version",
    "release:artifacts": "tsx scripts/check-package-artifacts.ts",
    "release:check": "run-s lint typecheck test",
    "release:consumer": "tsx scripts/smoke-test-package.ts",
    "release:verify": "run-s build release:check docs:verify apps:verify release:artifacts release:consumer",
    "release:version": "bumpp -r",
    "test": "vitest",
    "theme-studio:dev": "pnpm --filter @docxkit/theme-studio run dev",
    "typecheck": "tsc --noEmit && pnpm -r exec tsc --noEmit && pnpm run apps:typecheck",
    "visual:check": "run-s visual:generate visual:render",
    "visual:generate": "tsx scripts/visual-regression/generate-fixtures.ts",
    "visual:render": "tsx scripts/visual-regression/render-and-compare.ts",
    "visual:update": "pnpm run visual:generate && tsx scripts/visual-regression/render-and-compare.ts --update"
  },
  "devDependencies": {
    "@docxkit/core": "workspace:*",
    "@ntnyq/eslint-config": "^7.0.0-beta.28",
    "@ntnyq/prettier-config": "^3.1.0",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "bumpp": "^12.3.0",
    "echarts": "^6.1.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jszip": "^3.10.2",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,md,vue,yml,yaml,toml,json}": "eslint --fix",
    "*.{css,scss,html}": "prettier -uw"
  }
}
