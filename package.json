{
  "name": "docx-kit",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.2",
  "description": "CSS-like DOCX API Kit — a type-safe, plugin-extensible DOCX generation library built on dolanmiu/docx.",
  "keywords": [
    "document",
    "docx",
    "generator",
    "library",
    "report",
    "template",
    "typescript",
    "word"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github.com/ntnyq/docx-kit#readme",
  "repository": "ntnyq/docx-kit",
  "bugs": {
    "url": "https://github.com/ntnyq/docx-kit/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "echarts": ">=5.0.0",
    "qrcode": ">=1.5.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "docx": "^9.7.1"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^6.1.5",
    "@ntnyq/prettier-config": "^3.0.1",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.5",
    "bumpp": "^11.1.0",
    "echarts": "^6.1.0",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.1",
    "prettier": "^3.8.4",
    "qrcode": "^1.5.4",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,md,vue,yml,yaml,toml,json}": "eslint --fix",
    "*.{css,scss,html}": "prettier -uw"
  }
}
