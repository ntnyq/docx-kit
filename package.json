{
  "name": "docx-kit",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "description": "CSS-like DOCX API Kit — a type-safe, plugin-extensible DOCX generation library built on dolanmiu/docx.",
  "license": "MIT",
  "scripts": {
    "bench:browser": "node scripts/performance/run-browser.mjs",
    "bench:browser:update": "node scripts/performance/run-browser.mjs --update-baseline",
    "bench:node": "node scripts/performance/run-node.mjs",
    "bench:node:update": "node scripts/performance/run-node.mjs --update-baseline",
    "build": "pnpm -r --filter \"!docs\" run build",
    "dev": "pnpm -r --filter \"!docs\" --parallel run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:bundle": "node scripts/check-doc-bundle.mjs",
    "docs:dev": "pnpm -C docs run dev",
    "docs:examples": "node scripts/check-doc-examples.mjs",
    "docs:generated": "git diff --exit-code -- docs/.vitepress/utils/monacoTypes.generated.ts",
    "docs:verify": "run-s docs:examples docs:build docs:bundle docs:generated",
    "lint": "eslint",
    "prepare": "husky",
    "release": "run-s release:verify release:version",
    "release:artifacts": "node scripts/check-package-artifacts.mjs",
    "release:check": "run-s lint typecheck test",
    "release:consumer": "node scripts/smoke-test-package.mjs",
    "release:verify": "run-s build release:check docs:verify release:artifacts release:consumer",
    "release:version": "bumpp -r",
    "test": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "visual:check": "run-s visual:generate visual:render",
    "visual:generate": "pnpm --filter docs exec tsx ../scripts/visual-regression/generate-fixtures.mjs",
    "visual:render": "node scripts/visual-regression/render-and-compare.mjs",
    "visual:update": "pnpm run visual:generate && node scripts/visual-regression/render-and-compare.mjs --update"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.13",
    "@ntnyq/prettier-config": "^3.1.0",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "bumpp": "^12.0.0",
    "bwip-js": "^4.11.2",
    "echarts": "^6.1.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "jszip": "^3.10.1",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,md,vue,yml,yaml,toml,json}": "eslint --fix",
    "*.{css,scss,html}": "prettier -uw"
  }
}
