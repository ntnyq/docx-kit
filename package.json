{
  "name": "docx-kit",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "description": "CSS-like DOCX API Kit — a type-safe, plugin-extensible DOCX generation library built on dolanmiu/docx.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter '!docs' run build",
    "dev": "pnpm -r --filter '!docs' --parallel run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "lint": "eslint",
    "prepare": "husky",
    "release": "run-s release:check release:version",
    "release:check": "run-s lint typecheck test",
    "release:version": "bumpp -r",
    "test": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^6.1.5",
    "@ntnyq/prettier-config": "^3.0.1",
    "@types/node": "^25.9.2",
    "@types/qrcode": "^1.5.6",
    "bumpp": "^11.1.0",
    "echarts": "^6.1.0",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.1",
    "prettier": "^3.8.4",
    "qrcode": "^1.5.4",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,md,vue,yml,yaml,toml,json}": "eslint --fix",
    "*.{css,scss,html}": "prettier -uw"
  }
}
