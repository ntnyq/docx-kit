{
  "name": "docx-kit",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "description": "CSS-like DOCX API Kit — a type-safe, plugin-extensible DOCX generation library built on dolanmiu/docx.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter \"!docs\" run build",
    "dev": "pnpm -r --filter \"!docs\" --parallel run dev",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "docs:examples": "node scripts/check-doc-examples.mjs",
    "docs:generated": "git diff --exit-code -- docs/.vitepress/utils/monacoTypes.generated.ts",
    "docs:verify": "run-s docs:examples docs:build docs:generated",
    "lint": "eslint",
    "prepare": "husky",
    "release": "run-s release:verify release:version",
    "release:artifacts": "node scripts/check-package-artifacts.mjs",
    "release:check": "run-s lint typecheck test",
    "release:consumer": "node scripts/smoke-test-package.mjs",
    "release:verify": "run-s build release:check docs:verify release:artifacts release:consumer",
    "release:version": "bumpp -r",
    "test": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^6.1.5",
    "@ntnyq/prettier-config": "^3.1.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "bumpp": "^11.1.0",
    "echarts": "^6.1.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.5",
    "qrcode": "^1.5.4",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,md,vue,yml,yaml,toml,json}": "eslint --fix",
    "*.{css,scss,html}": "prettier -uw"
  }
}
