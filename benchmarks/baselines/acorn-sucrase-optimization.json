  "changes": [
    "One Acorn parse instead of two; reverse source edits preserve import binding and final-expression behavior.",
    "A production-only Sucrase profile folds transform selection to TypeScript, removes validation of the app-owned typed options, and removes unused source-map generation. Node and development use the normal public Sucrase entry.",
    "Sucrase is pinned to 3.35.1. Build guards verify the caller options and audited dependency source structure; production differential tests compare the profiled bundle to normal Sucrase output."
  ],
  "method": {
    "assets": "Actual Vite production compiler chunks; no WASM or additional runtime asset. Shared unchanged rolldown runtime excluded.",
    "allAssets": "Sum of every Playground assets file, including lazy chunks, workers, fonts and CSS; this is not initial-page transfer.",
    "gzip": "gzip level 9, deterministic mtime=0.",
    "browserCold": "Nine fresh Chrome processes per variant, alternating before/after. Uncompressed loopback HTTP without network/CPU throttling; median includes compiler import and first basic conversion. Does not include DOCX generation or the rest of the app.",
    "browserWarm": "Three rounds per variant in alternating order in one browser process, each in a fresh document. Engine/module caches may be reused.",
    "nodeWarm": "Three fresh Node processes per variant in alternating order. Original source snapshot has only parameter/return type annotations removed and uses the normal Node package entries.",
    "sampling": "100 warmups per scenario, nine batches of 100 conversions per round; median batch mean, then median of round medians. All round medians retained.",
    "compatibility": "Production profile is covered by 17 differential source fixtures, including all eight presets, runtime enums, constructor properties, class fields, generic arrows, type imports and modern JS syntax. Invalid-source checks also run on the built bundle. Browser probes check runtime bindings, await/return, enum, constructor property, optional chaining and dynamic import.",
    "earlierTrial": "An earlier transformer-only profile reduced size but showed no stable cold-start improvement; final measurements here include removal of the unused validator/source-map dependencies. Earlier raw samples remain under output/performance/acorn-sucrase-optimization/phase-one.",
    "reproduceNode": "pnpm bench:prepare-code --output output/performance/prepare-code.json; add --module <baseline-module> to run a source snapshot.",
    "maintenance": "Changing the Sucrase version, source layout, or compiler options requires reviewing the build profile. Guards fail the build instead of applying an unverified specialization."
  },
