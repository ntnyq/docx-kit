{
  "eslint.enable": true,
  "prettier.enable": true,
  "editor.formatOnSave": true,
  "prettier.configPath": "./prettier.config.mjs",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never",
    "source.sortImports": "never"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "eslint.validate": [
    "vue",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "cSpell.words": [
    "BFBFBF",
    "bumpp",
    "bwip",
    "Calibri",
    "changelogithub",
    "codecov",
    "Consolas",
    "dedup",
    "docxjs",
    "dolanmiu",
    "EDEDED",
    "esbuild",
    "KHTML",
    "lcov",
    "noopener",
    "noreferrer",
    "OMML",
    "OOXML",
    "pdftoppm",
    "pnpm",
    "Poppler",
    "qrcode",
    "reka",
    "rels",
    "Segoe",
    "tsdown",
    "Twip",
    "twips",
    "unhighlighted",
    "unrs",
    "unstub",
    "verkit",
    "vite",
    "vitepress",
    "vitest",
    "vueuse",
    "wordprocessingml",
    "xlarge"
  ],
  "cSpell.allowCompoundWords": true
}
