{
  "name": "@docxkit/types",
  "type": "module",
  "version": "0.5.0",
  "description": "Shared type definitions and utility types for docx-kit monorepo packages.",
  "keywords": [
    "docx",
    "docx-kit",
    "types"
  ],
  "license": "MIT",
  "author": "ntnyq",
  "homepage": "https://docx-kit.ntnyq.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/docx-kit.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/ntnyq/docx-kit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
