{
  "name": "@docxkit/loader",
  "type": "module",
  "version": "0.4.0",
  "description": "Plugin loader for docx-kit with platform-specific sources",
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/docx-kit.git",
    "directory": "packages/loader"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/loader-browser.d.ts",
      "default": "./dist/loader-browser.js"
    },
    "./node": {
      "types": "./dist/loader-node.d.ts",
      "default": "./dist/loader-node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@docxkit/core": "workspace:*",
    "docx": "^9.7.1"
  }
}
