{
  "name": "@docxkit/core",
  "type": "module",
  "version": "0.7.0",
  "description": "Core engine for docx-kit — CSS-like DOCX generation library",
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
