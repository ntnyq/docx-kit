{
  "name": "@docxkit/markdown",
  "type": "module",
  "version": "0.7.0",
  "description": "Markdown to docx-kit DSL conversion for browser and Node.js",
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/docx-kit.git",
    "directory": "packages/markdown"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@docxkit/types": "workspace:*",
    "entities": "^8.1.0",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "jszip": "^3.10.2"
  }
}
