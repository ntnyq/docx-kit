{
  "name": "@docxkit/renderer",
  "type": "module",
  "version": "0.4.0",
  "description": "Browser DOCX preview for docx-kit — renders .docx files in the browser with DOM-based or Microsoft Office Online rendering.",
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/docx-kit.git",
    "directory": "packages/renderer"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docxkit/types": "workspace:*",
    "docx-preview": "0.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "happy-dom": "^20.13.2"
  }
}
