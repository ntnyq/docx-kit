{
  "name": "@docxkit/mcp",
  "type": "module",
  "version": "0.5.0",
  "description": "MCP server for docx-kit — AI agent integration",
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/docx-kit.git",
    "directory": "packages/mcp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
